cabal-version:      3.0
name:               hs-archiver
version:            0.1.0.0
license:            NONE
author:             Gemini CLI
maintainer:         gemini@example.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common shared-properties
    ghc-options: -Wall
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , DeriveGeneric
                      , RecordWildCards
                      , ScopedTypeVariables

library
    import:           shared-properties
    exposed-modules:  Smap.Types
                    , Smap.Query.AST
                    , Smap.Query.Parser
                    , Smap.Db
                    , Smap.Db.Query
                    , Smap.Api
    build-depends:    base >=4.17 && <5
                    , aeson
                    , text
                    , bytestring
                    , time
                    , containers
                    , uuid
                    , vector
                    , unordered-containers
                    , megaparsec
                    , parser-combinators
                    , postgresql-simple
                    , resource-pool
                    , servant
                    , servant-server
                    , warp
                    , transformers
    hs-source-dirs:   src

executable hs-archiver
    import:           shared-properties
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base >=4.17 && <5
                    , hs-archiver
                    , warp
                    , text
    hs-source-dirs:   app
